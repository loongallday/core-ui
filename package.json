{
  "name": "@core-erp/ui",
  "version": "2.0.0",
  "description": "Shared UI components and design system for Core ERP applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/ui": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js"
    },
    "./components/responsive": {
      "types": "./dist/components/responsive/index.d.ts",
      "import": "./dist/components/responsive/index.js"
    },
    "./components/loading": {
      "types": "./dist/components/loading/index.d.ts",
      "import": "./dist/components/loading/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./lib/theme-config": {
      "types": "./dist/lib/theme-config.d.ts",
      "import": "./dist/lib/theme-config.js"
    },
    "./lib/component-defaults": {
      "types": "./dist/lib/component-defaults.d.ts",
      "import": "./dist/lib/component-defaults.js"
    },
    "./lib/breakpoints": {
      "types": "./dist/lib/breakpoints.d.ts",
      "import": "./dist/lib/breakpoints.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./styles": "./src/styles/globals.css",
    "./styles/tokens": "./src/styles/tokens.css",
    "./tailwind-preset": "./tailwind.config.js"
  },
  "files": [
    "dist",
    "src/styles",
    "tailwind.config.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
